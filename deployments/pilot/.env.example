POSTGRES_ADMIN_PASSWORD=replace-with-secret
SKAWLD_DB_OWNER_PASSWORD=replace-with-secret
SKAWLD_DB_APP_PASSWORD=replace-with-secret

OIDC_ISSUER_URL=https://identity.example.internal/realms/skawld
