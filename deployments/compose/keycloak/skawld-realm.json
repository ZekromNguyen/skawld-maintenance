{
  "realm": "skawld",
  "enabled": true,
  "displayName": "Skawld Development",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "clients": [
    {
      "clientId": "skawld-web",
      "name": "Skawld Web",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-web-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8080/auth/callback"],
      "webOrigins": ["http://localhost:5173"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "Skawld API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "skawld-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "skawld-mobile",
      "name": "Skawld Mobile",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:*",
        "com.skawld.maintenance:/oauthredirect"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "Skawld API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "skawld-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "00000000-0000-4000-8000-000000000001",
      "username": "phase0.admin",
      "firstName": "Phase 0",
      "lastName": "Administrator",
      "email": "phase0.admin@example.invalid",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "phase0-admin-dev",
          "temporary": false
        }
      ]
    }
  ]
}
