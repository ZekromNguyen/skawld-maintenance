# Development-only values. Replace every credential outside a local machine.
APP_ENV=development
HTTP_ADDRESS=:8080

DATABASE_URL=postgres://skawld_app:skawld_app_dev@localhost:5432/skawld?sslmode=disable
MIGRATION_DATABASE_URL=postgres://skawld_owner:skawld_owner_dev@localhost:5432/skawld?sslmode=disable
DATABASE_API_MAX_CONNS=10
DATABASE_WORKER_MAX_CONNS=10
DATABASE_MAX_CONNECTION_BUDGET=25
DATABASE_STATEMENT_TIMEOUT=15s
DATABASE_LOCK_TIMEOUT=3s

OIDC_ISSUER_URL=http://localhost:8081/realms/skawld
OIDC_CLIENT_ID=skawld-web
OIDC_CLIENT_SECRET=dev-web-secret
OIDC_AUDIENCE=skawld-api
OIDC_REDIRECT_URL=http://localhost:8080/auth/callback
SESSION_COOKIE_NAME=skawld_session
SESSION_COOKIE_SECURE=false
SESSION_TTL=8h
BOOTSTRAP_OIDC_SUBJECTS=00000000-0000-4000-8000-000000000001

JOB_CONCURRENCY_EMBEDDING=5
JOB_CONCURRENCY_REPORT=10
JOB_CONCURRENCY_VISION=3
JOB_CONCURRENCY_TRANSCRIPTION=3
PDFTOTEXT_BINARY=pdftotext

# Optional configured/private/cloud speech endpoint. No public provider is required.
# Expected multipart endpoint compatible with fields: file, model, response_format.
TRANSCRIPTION_ENDPOINT=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_PROVIDER=unavailable
TRANSCRIPTION_MODEL=unavailable
TRANSCRIPTION_MODEL_VERSION=none

# Optional S3 contract-test profile only.
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=skawld-dev
S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=dev-secret-key
S3_USE_PATH_STYLE=true
